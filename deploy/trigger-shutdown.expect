#!/usr/bin/env -S expect -f
#
# Log into a running GRIM server as an admin character over localhost telnet and
# issue `shutdown <secs>`, so connected players get the in-game countdown before
# the process exits. Best-effort: exits non-zero if the login flow doesn't match,
# and the caller (deploy.sh) falls back to `systemctl stop`.
#
# Usage: trigger-shutdown.expect <port> <login> <password> <seconds>

set port     [lindex $argv 0]
set login    [lindex $argv 1]
set password [lindex $argv 2]
set secs     [lindex $argv 3]
set timeout  20

spawn telnet localhost $port

# Login banner then the identifier prompt.
expect {
    -re "(?i)(name|login|email|identifier)" { send -- "$login\r" }
    timeout { exit 1 }
}
expect {
    -re "(?i)password"                      { send -- "$password\r" }
    timeout { exit 1 }
}
# After auth the admin (logged in by character name) auto-selects and hits the
# MOTD prompt — pressing Enter drops into the world. If we're somewhere else,
# a bare Enter is harmless.
expect {
    -re "(?i)(enter|motd|welcome)"          { send -- "\r" }
    timeout                                 { send -- "\r" }
}
sleep 1
send -- "shutdown $secs\r"
expect {
    -re "(?i)(restart|shutting|server)"     { }
    timeout                                 { }
}
send -- "quit\r"
expect eof
exit 0
